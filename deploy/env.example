# Titan Central API environment TEMPLATE. Placeholders only. Never commit real values.
#
# Storage: copy to /etc/titan-central/central.env, owned by root:root, mode 0600.
# systemd reads it through EnvironmentFile= in central.service. Do not copy it into
# the application directory, the repository, a ZIP, or chat.
#
# Every REPLACE_ME value must be filled in on the server, EXCEPT the operator block below.
# The operator block is optional. Either delete those lines (or leave them empty) to keep the
# /v1/admin/ routes off (404), or fill in every one of them. A REPLACE_ME left in any
# operator line stops startup on purpose.

# PostgreSQL connection for the separate titan_central database (ADR-003).
# Use a restricted service role; never the Desk, Field or Logto database roles.
TITAN_CENTRAL_DATABASE_URL=REPLACE_ME

# Logto OIDC issuer and JWKS URI used to verify access tokens.
TITAN_OIDC_ISSUER=REPLACE_ME
TITAN_OIDC_JWKS_URI=REPLACE_ME

# One distinct audience per application (ADR-005). They must all differ.
TITAN_FIELD_AUDIENCE=REPLACE_ME
TITAN_DESK_AUDIENCE=REPLACE_ME
TITAN_ACADEMY_AUDIENCE=REPLACE_ME

# 32-byte random key, base64-encoded, for sealing PKCE verifiers at rest.
# Generate on the server (openssl rand -base64 32). Never reuse it across environments.
# Losing it makes in-flight logins fail closed; rotating it does the same.
TITAN_OIDC_STATE_KEY=REPLACE_ME

# Loopback port the API listens on (127.0.0.1 only). Default in server.mjs is 3102.
TITAN_CENTRAL_PORT=3102

# ---- Operator (admin) plane. Optional. See apps/control-api/src/operator-config.mjs. ----
# The admin routes mount only when BOTH of the first two are set and valid. Otherwise they answer 404.
# Once either is set, startup throws unless every operator variable below is valid.
#
# TITAN_OPERATOR_ORGANISATION_ID: one Logto organisation ID that operators belong to. Opaque ID, no spaces.
# TITAN_OPERATOR_ROLE_IDS: comma-separated Logto organisation role IDs, 1 to 32 unique values.
#   An operator must be a current member of that organisation AND hold at least one of these roles.
#   Email addresses, display names and local Desk/Field profiles are never consulted.
TITAN_OPERATOR_ORGANISATION_ID=REPLACE_ME
TITAN_OPERATOR_ROLE_IDS=REPLACE_ME

# Logto Management API connection, required whenever the operator plane is on.
# Server-side only: the M2M client credentials are never accepted from requests.
# TITAN_LOGTO_MANAGEMENT_ORIGIN: HTTPS origin of the Logto tenant. No path, query or userinfo.
# TITAN_LOGTO_M2M_CLIENT_ID: machine-to-machine application ID with Management API access.
# TITAN_LOGTO_M2M_CLIENT_SECRET: that application's secret. Lives only in this file (root:root, 0600).
#   It is never logged, returned in a response, or included in an error message.
# TITAN_LOGTO_MANAGEMENT_RESOURCE: HTTPS Management API resource indicator, requested in the client-credentials grant.
# TITAN_LOGTO_MANAGEMENT_SCOPE: space-separated scopes requested for that grant, with no default. Use the minimum
#   the M2M application is granted in Logto (the operator authority checks only read membership and roles).
TITAN_LOGTO_MANAGEMENT_ORIGIN=REPLACE_ME
TITAN_LOGTO_M2M_CLIENT_ID=REPLACE_ME
TITAN_LOGTO_M2M_CLIENT_SECRET=REPLACE_ME
TITAN_LOGTO_MANAGEMENT_RESOURCE=REPLACE_ME
TITAN_LOGTO_MANAGEMENT_SCOPE=REPLACE_ME

# Fixed application origins (HTTPS, no path), used only to build the reviewed OIDC registration plans shown by
# GET /v1/admin/oidc/plans. Three distinct origins are required. Nothing is registered by calling the route.
TITAN_DESK_ORIGIN=REPLACE_ME
TITAN_FIELD_ORIGIN=REPLACE_ME
TITAN_ACADEMY_ORIGIN=REPLACE_ME

# Authentication abuse protection is configured in application source and
# deploy/proxy templates, not through unsafe client-provided limits.
# Default application concurrency caps: access 8/socket, 96 global;
# product OIDC 3/socket, 48 global; Central OIDC 3/socket, 48 global;
# selection POST 2/socket, 32 global; launcher 5/socket, 72 global.
# Source socket may be loopback behind DirectAdmin. Per-client rate and
# concurrency limits MUST be configured and tested at the actual proxy.
# No additional browser or production capability is enabled by these defaults.
