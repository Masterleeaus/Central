# Titan Central API environment TEMPLATE. Placeholders only. Never commit real values.
#
# Storage: copy to /etc/titan-central/central.env, owned by root:root, mode 0600.
# systemd reads it through EnvironmentFile= in central.service. Do not copy it into
# the application directory, the repository, a ZIP, or chat.
#
# Every REPLACE_ME value must be filled in on the server, EXCEPT the operator block below.
# The operator block is optional. Either delete those lines (or leave them empty) to keep the
# /v1/admin/ routes off (404), or fill in every one of them. A REPLACE_ME left in any
# operator line stops startup on purpose.
#
# VARIABLE TABLE. Checked by apps/control-api/test/env-template.test.mjs against every TITAN_* name read
# under apps/control-api/src. Keep the table, the code and this file in step. Location is the file the
# variable belongs in. "yes" in Secret means the value is never placed in the repository, a ZIP or chat.
# | Variable | Location | Secret | Owner |
# |---|---|---|---|
# | TITAN_CENTRAL_DATABASE_URL | central.env | yes | Platform operator (restricted DB role) |
# | TITAN_OIDC_ISSUER | central.env | no | Logto owner |
# | TITAN_OIDC_JWKS_URI | central.env | no | Logto owner |
# | TITAN_FIELD_AUDIENCE | central.env | no | Logto owner (one audience per app, ADR-005) |
# | TITAN_DESK_AUDIENCE | central.env | no | Logto owner (one audience per app, ADR-005) |
# | TITAN_ACADEMY_AUDIENCE | central.env | no | Logto owner (one audience per app, ADR-005) |
# | TITAN_OIDC_STATE_KEY | central.env | yes | Platform operator (generated on the server) |
# | TITAN_CENTRAL_PORT | central.env | no | Platform operator (loopback port) |
# | TITAN_SKILLED_DECISION_BEARER | central.env | yes | Platform operator (Skilled service credential, optional) |
# | TITAN_OPERATOR_FLAG_CHANGES | central.env | no | Platform operator (operator flag changes policy) |
# | TITAN_CONFIG_READ_PRODUCTS | central.env | no | Platform operator (configuration read product scope) |
# | TITAN_ALLOW_INSECURE_LOCALHOST | central.env | no | Development only, never set in production |
# | TITAN_OPERATOR_ORGANISATION_ID | central.env | no | Logto owner (operator organisation) |
# | TITAN_OPERATOR_ROLE_IDS | central.env | no | Logto owner (operator organisation roles) |
# | TITAN_LOGTO_MANAGEMENT_ORIGIN | central.env | no | Logto owner (tenant origin) |
# | TITAN_LOGTO_M2M_CLIENT_ID | central.env | no | Logto owner (M2M application) |
# | TITAN_LOGTO_M2M_CLIENT_SECRET | central.env | yes | Logto owner (M2M application) |
# | TITAN_LOGTO_MANAGEMENT_RESOURCE | central.env | no | Logto owner (Management API resource) |
# | TITAN_LOGTO_MANAGEMENT_SCOPE | central.env | no | Logto owner (granted scopes) |
# | TITAN_FIELD_ORIGIN | central.env | no | Product registry (docs/PRODUCT_REGISTRY.md) |
# | TITAN_DESK_ORIGIN | central.env | no | Product registry (docs/PRODUCT_REGISTRY.md) |
# | TITAN_ACADEMY_ORIGIN | central.env | no | Product registry (docs/PRODUCT_REGISTRY.md) |
# | TITAN_PRODUCT_TRUSTED_ORIGINS | central.env | no | Platform operator (origin allowlist) |
# | TITAN_OUTBOX_DATABASE_URL | outbox-worker.env | yes | Platform operator (publisher DB role) |
# | TITAN_OUTBOX_ROUTES | outbox-worker.env | no | Platform operator (route list; secrets are named, not inline) |
# | TITAN_OUTBOX_POLL_INTERVAL_MS | outbox-worker.env | no | Platform operator (optional tuning) |
# | TITAN_OUTBOX_BATCH_SIZE | outbox-worker.env | no | Platform operator (optional tuning) |
# | TITAN_OUTBOX_MAX_ATTEMPTS | outbox-worker.env | no | Platform operator (optional tuning) |
# | TITAN_OUTBOX_REQUEST_TIMEOUT_MS | outbox-worker.env | no | Platform operator (optional tuning) |
# | TITAN_OUTBOX_SHUTDOWN_TIMEOUT_MS | outbox-worker.env | no | Platform operator (optional tuning) |
#
# Outbox variables are read by the outbox worker from deploy/outbox-worker.env.example, not from this file.
# Outbox route secrets are named by their own variables there and are not listed here.

# PostgreSQL connection for the separate titan_central database (ADR-003).
# Use a restricted service role; never the Desk, Field or Logto database roles.
TITAN_CENTRAL_DATABASE_URL=REPLACE_ME

# Logto OIDC issuer and JWKS URI used to verify access tokens.
TITAN_OIDC_ISSUER=REPLACE_ME
TITAN_OIDC_JWKS_URI=REPLACE_ME

# One distinct audience per application (ADR-005). They must all differ.
TITAN_FIELD_AUDIENCE=REPLACE_ME
TITAN_DESK_AUDIENCE=REPLACE_ME
TITAN_ACADEMY_AUDIENCE=REPLACE_ME

# 32-byte random key, base64-encoded, for sealing PKCE verifiers at rest.
# Generate on the server (openssl rand -base64 32). Never reuse it across environments.
# Losing it makes in-flight logins fail closed; rotating it does the same.
TITAN_OIDC_STATE_KEY=REPLACE_ME

# Loopback port the API listens on (127.0.0.1 only). Default in server.mjs is 3102.
TITAN_CENTRAL_PORT=3102

# ---- Operator (admin) plane. Optional. See apps/control-api/src/operator-config.mjs. ----
# The admin routes mount only when BOTH of the first two are set and valid. Otherwise they answer 404.
# Once either is set, startup throws unless every operator variable below is valid.
#
# TITAN_OPERATOR_ORGANISATION_ID: one Logto organisation ID that operators belong to. Opaque ID, no spaces.
# TITAN_OPERATOR_ROLE_IDS: comma-separated Logto organisation role IDs, 1 to 32 unique values.
#   An operator must be a current member of that organisation AND hold at least one of these roles.
#   Email addresses, display names and local Desk/Field profiles are never consulted.
TITAN_OPERATOR_ORGANISATION_ID=REPLACE_ME
TITAN_OPERATOR_ROLE_IDS=REPLACE_ME

# Logto Management API connection, required whenever the operator plane is on.
# Server-side only: the M2M client credentials are never accepted from requests.
# TITAN_LOGTO_MANAGEMENT_ORIGIN: HTTPS origin of the Logto tenant. No path, query or userinfo.
# TITAN_LOGTO_M2M_CLIENT_ID: machine-to-machine application ID with Management API access.
# TITAN_LOGTO_M2M_CLIENT_SECRET: that application's secret. Lives only in this file (root:root, 0600).
#   It is never logged, returned in a response, or included in an error message.
# TITAN_LOGTO_MANAGEMENT_RESOURCE: HTTPS Management API resource indicator, requested in the client-credentials grant.
# TITAN_LOGTO_MANAGEMENT_SCOPE: space-separated scopes requested for that grant, with no default. Use the minimum
#   the M2M application is granted in Logto (the operator authority checks only read membership and roles).
TITAN_LOGTO_MANAGEMENT_ORIGIN=REPLACE_ME
TITAN_LOGTO_M2M_CLIENT_ID=REPLACE_ME
TITAN_LOGTO_M2M_CLIENT_SECRET=REPLACE_ME
TITAN_LOGTO_MANAGEMENT_RESOURCE=REPLACE_ME
TITAN_LOGTO_MANAGEMENT_SCOPE=REPLACE_ME

# Product service origins (HTTPS, no path), validated against the product registry at every startup
# (docs/PRODUCT_REGISTRY.md). The variable names keep their legacy suffixes until the rename is done:
# TITAN_FIELD_ORIGIN is Sorted, TITAN_DESK_ORIGIN is Supercharged, TITAN_ACADEMY_ORIGIN is LMS.
# Set all three together, or leave all three empty. Three distinct origins are required.
# They also feed the reviewed OIDC registration plans shown by GET /v1/admin/oidc/plans.
# Nothing is registered by calling the route.
TITAN_DESK_ORIGIN=REPLACE_ME
TITAN_FIELD_ORIGIN=REPLACE_ME
TITAN_ACADEMY_ORIGIN=REPLACE_ME

# Operator allowlist of product origins, comma-separated, each in the same HTTPS origin form. Required whenever
# any product origin above is set. An origin that is not on this list stops startup.
TITAN_PRODUCT_TRUSTED_ORIGINS=REPLACE_ME

# Optional. Dedicated service credential for the Skilled decision endpoint (off by default). Never a user's
# OIDC token. Must be 32 to 1024 characters of [A-Za-z0-9_.-]. Leave it commented out to keep the endpoint off.
# TITAN_SKILLED_DECISION_BEARER=REPLACE_ME

# Optional operator/configuration policy variables; configure only after reviewing the corresponding API controls.
# TITAN_OPERATOR_FLAG_CHANGES=REPLACE_ME
# TITAN_CONFIG_READ_PRODUCTS=REPLACE_ME

# Development only. Allows http://localhost URLs for OIDC and outbox consumers. Never set in production.
# TITAN_ALLOW_INSECURE_LOCALHOST=1
