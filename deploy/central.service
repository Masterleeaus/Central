# Titan Central API systemd unit TEMPLATE. Not installed by this repo.
#
# Replace every __PLACEHOLDER__ before installing, then:
#   sudo install -m 0644 central.service /etc/systemd/system/titan-central.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now titan-central
#
# Start / stop / restart:   systemctl start|stop|restart titan-central
# Status / logs:            systemctl status titan-central ; journalctl -u titan-central -n 200
# Rollback:                 point __APP_DIR__ at the previous immutable release directory,
#                           then systemctl restart titan-central. Never extract over live apps.
#
# Secrets live only in /etc/titan-central/central.env (root:root, mode 0600), created from
# deploy/env.example. They are never placed in this unit or in the repository.

[Unit]
Description=Titan Central API (loopback only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_GROUP__
WorkingDirectory=__APP_DIR__/apps/control-api
EnvironmentFile=/etc/titan-central/central.env
ExecStart=__NODE_BIN__ src/server.mjs
# SIGTERM closes the HTTP server and database pool (see installShutdown in server.mjs).
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=5

# Hardening: the service needs no write access to its code and no privilege escalation.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=multi-user.target
