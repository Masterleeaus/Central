# Titan Central outbox worker environment TEMPLATE. Placeholders only. Never commit real values.
#
# Storage: copy to /etc/titan-central/outbox-worker.env, owned by root:root, mode 0600.
# Read by outbox-worker.service through EnvironmentFile=. Route secrets are referenced by the NAME of a
# variable below (secretEnv), so each secret value is set as its own line on the server only.
# Every REPLACE_ME must be filled in on the server. A REPLACE_ME secret fails startup on purpose.

# Connection for the publisher role (titan_trusted_writer). Never the tenant or Desk, Field or Logto roles.
TITAN_OUTBOX_DATABASE_URL=REPLACE_ME

# JSON array of consumer routes. Each route has: consumer (name), organisationId (UUID), eventTypes (names),
# url (https, no credentials, query or fragment), and EITHER secretEnv (name of a variable below) OR keys
# (one or two entries with id, secretEnv, notBefore and notAfter, the two windows overlapping during rotation).
# Keep this value on one line.
TITAN_OUTBOX_ROUTES=[{"consumer":"REPLACE_ME","organisationId":"00000000-0000-4000-8000-000000000000","eventTypes":["REPLACE_ME"],"url":"https://REPLACE_ME/v1/outbox","secretEnv":"TITAN_OUTBOX_SECRET_REPLACE_ME"}]

# The route secret itself. At least 32 characters. Generate with: openssl rand -hex 32
TITAN_OUTBOX_SECRET_REPLACE_ME=REPLACE_ME

# Optional tuning. Defaults shown.
TITAN_OUTBOX_POLL_INTERVAL_MS=1000
TITAN_OUTBOX_BATCH_SIZE=20
TITAN_OUTBOX_MAX_ATTEMPTS=8
TITAN_OUTBOX_REQUEST_TIMEOUT_MS=10000
TITAN_OUTBOX_SHUTDOWN_TIMEOUT_MS=30000

# Development only. Allows http://localhost consumer URLs. Never set in production.
# TITAN_ALLOW_INSECURE_LOCALHOST=1
