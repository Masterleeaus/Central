# PRODUCT vhost only (Sorted/field, Supercharged/desk, LMS/academy).
# Do not include this in the Central host: app session cookies are app-owned.
# Requires zones.conf in nginx http{}, and exact __PRODUCT_PORT__ replacement.
location ~ ^/auth/titan/(field|desk|academy)/select$ {
    limit_req zone=titan_company_select burst=8 nodelay;
    limit_conn titan_conn 6;
    client_max_body_size 4k;
    proxy_connect_timeout 3s;
    proxy_read_timeout 15s;
    proxy_send_timeout 15s;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Forwarded "";
    proxy_pass http://127.0.0.1:__PRODUCT_PORT__;
}
